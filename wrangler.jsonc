{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "compatibility_date": "2026-05-07",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api-proxy/*", "/v1/*"]
  },
  // 部署时用 `wrangler secret put` 或 Cloudflare 控制台覆盖：
  // UPSTREAM_BASE_URL 上游 API 基础地址（含 /v1），ALLOWED_ORIGINS 允许访问的站点来源。
  "vars": {
    "UPSTREAM_BASE_URL": "",
    "ALLOWED_ORIGINS": ""
  }
}
